<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/pebble_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/pebble_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.Pebble">

        <!-- Launcher Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Onboarding Activities -->
        <activity android:name=".ui.onboarding.NameInputActivity" />
        <activity android:name=".ui.onboarding.WalletSetupActivity" />

        <!-- Home & Core Activities -->
        <activity android:name=".ui.home.HomeActivity" />
        <activity android:name=".ui.income.IncomeDetailActivity" />  <!-- ✅ ADD THIS -->
        <activity android:name=".ui.wallets.WalletsActivity" />
        <activity android:name=".ui.wallets.WalletDetailsActivity" />

        <!-- Transaction Activities -->
        <activity android:name=".ui.transaction.AddTransactionActivity" />
        <activity android:name=".ui.transaction.TransferActivity" />

        <!-- Settings Activities -->
        <activity android:name=".ui.settings.SettingsActivity" />
        <activity android:name=".ui.settings.CategoryManagerActivity" />

    </application>
</manifest>