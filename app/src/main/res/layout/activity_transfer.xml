<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_transfer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface">

    <!-- Back Button -->
    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:src="@drawable/ic_minimal_up"
        android:rotation="-90"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/color_on_surface"
        android:contentDescription="@string/content_desc_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="@string/title_transfer"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/color_on_surface"
        android:fontFamily="@font/outfit"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintBottom_toTopOf="@id/btn_transfer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <!-- Amount Display -->
            <EditText
                android:id="@+id/et_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:gravity="center"
                android:hint="0"
                android:textColorHint="#33FFFFFF"
                android:textColor="@color/color_on_surface"
                android:textSize="56sp"
                android:textStyle="bold"
                android:fontFamily="@font/outfit"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INR"
                android:gravity="center"
                android:textColor="@color/color_on_surface_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.15"
                android:layout_marginBottom="32dp" />

            <!-- From Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="From"
                android:textColor="@color/color_on_surface_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.05"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:id="@+id/ll_from_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Swap Icon -->
            <LinearLayout
                android:id="@+id/btn_swap"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:layout_marginBottom="24dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_minimal_down"
                    app:tint="@color/color_on_surface_secondary" />
            </LinearLayout>

            <!-- To Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="To"
                android:textColor="@color/color_on_surface_secondary"
                android:textSize="14sp"
                android:fontFamily="@font/outfit"
                android:letterSpacing="0.05"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:id="@+id/ll_to_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Note -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_card_grey"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_minimal_note"
                    app:tint="@color/color_on_surface_secondary"
                    android:layout_marginEnd="16dp" />

                <EditText
                    android:id="@+id/et_note"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:hint="Add note"
                    android:textColorHint="@color/color_on_surface_secondary"
                    android:textColor="@color/color_on_surface"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Transfer Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_transfer"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Transfer"
        android:textSize="18sp"
        android:fontFamily="@font/outfit"
        android:textStyle="bold"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        app:backgroundTint="@color/color_on_surface"
        android:textColor="@color/color_surface"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
