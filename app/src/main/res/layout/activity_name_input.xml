<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Container for dynamic rounded top corners over the black status bar -->
    <FrameLayout
        android:id="@+id/rounded_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_onboarding_rounded_top">

        <ViewFlipper
            android:id="@+id/view_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ======================== -->
            <!-- STEP 1: NAME INPUT       -->
            <!-- ======================== -->
            <LinearLayout
                android:id="@+id/layout_step_name"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="32dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/iv_logo"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/pebble_logo"
                        android:scaleType="centerCrop" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Let's get\nacquainted"
                    android:textColor="#FFFFFF"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="0dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/outfit" />

                <TextView
                    android:id="@+id/tv_subheadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What's your name?"
                    android:textColor="#88FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="@font/outfit"
                    android:layout_marginBottom="48dp" />

                <EditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_onboarding_input_minimal"
                    android:hint="Your first name"
                    android:textColorHint="#44FFFFFF"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:fontFamily="@font/outfit"
                    android:paddingHorizontal="24dp"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLines="1"
                    android:imeOptions="actionNext"
                    android:layout_marginBottom="32dp" />

                <!-- Continue Button -->
                <TextView
                    android:id="@+id/btn_continue"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_onboarding_btn_minimal"
                    android:text="Continue"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:fontFamily="@font/outfit"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="24dp"/>

            </LinearLayout>

            <!-- ======================== -->
            <!-- STEP 2: WALLET SETUP     -->
            <!-- ======================== -->
            <LinearLayout
                android:id="@+id/layout_step_wallet"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="32dp"
                android:paddingTop="64dp">

                <TextView
                    android:id="@+id/tv_welcome_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Great"
                    android:textColor="#88FFFFFF"
                    android:fontFamily="@font/outfit"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_wallet_headline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Create your\nfirst wallet"
                    android:textColor="#FFFFFF"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/outfit"
                    android:lineSpacingExtra="0dp"
                    android:layout_marginBottom="48dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_wallets"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/btn_add_another"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="+ Add another wallet"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="@font/outfit"
                    android:gravity="center"
                    android:paddingHorizontal="24dp"
                    android:background="@drawable/bg_onboarding_input_minimal"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp"/>

                <!-- Get Started Button -->
                <TextView
                    android:id="@+id/btn_get_started"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_onboarding_btn_minimal"
                    android:text="Start Tracking"
                    android:textColor="#000000"
                    android:textSize="20sp"
                    android:fontFamily="@font/outfit"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="24dp" />

            </LinearLayout>

        </ViewFlipper>
    </FrameLayout>
</FrameLayout>
