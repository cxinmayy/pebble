<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_onboarding_rounded_top">

    <!-- Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#44FFFFFF" />

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Reorder Wallets"
        android:textSize="22sp"
        android:textStyle="bold"
        android:fontFamily="@font/outfit"
        android:textColor="@color/color_on_surface"
        android:layout_marginTop="24dp"
        android:layout_marginHorizontal="24dp" />
        
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hold and drag to change your primary order"
        android:textSize="14sp"
        android:fontFamily="@font/outfit"
        android:textColor="@color/color_on_surface_secondary"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_reorder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp"
        android:maxHeight="400dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Cancel"
            android:textColor="@color/color_on_surface"
            app:backgroundTint="@color/color_surface"
            app:strokeColor="@color/color_surface_variant"
            app:strokeWidth="1dp"
            app:cornerRadius="16dp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="Save"
            android:textColor="@color/color_surface"
            app:backgroundTint="@color/color_on_surface"
            app:cornerRadius="16dp"
            android:layout_marginStart="8dp"/>

    </LinearLayout>

</LinearLayout>
