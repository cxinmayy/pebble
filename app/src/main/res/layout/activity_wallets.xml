<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_wallets"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_surface">

    <ImageButton
        android:id="@+id/btn_back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:src="@drawable/ic_minimal_up"
        android:rotation="-90"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/color_on_surface"
        android:contentDescription="@string/content_desc_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:text="My wallets"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/color_on_surface"
        android:fontFamily="@font/outfit"
        app:layout_constraintTop_toBottomOf="@id/btn_back"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btn_reorder"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:src="@drawable/ic_reorder_modern"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/color_on_surface"
        app:layout_constraintBottom_toBottomOf="@id/tv_title"
        app:layout_constraintTop_toTopOf="@id/tv_title"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_total_balance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:text="TOTAL BALANCE"
        android:textSize="12sp"
        android:textColor="@color/color_on_surface_secondary"
        android:fontFamily="@font/outfit"
        android:letterSpacing="0.1"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_total_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="4dp"
        android:text="₹0.00"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/color_on_surface"
        android:fontFamily="@font/outfit"
        app:layout_constraintTop_toBottomOf="@id/tv_total_balance_label"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_wallets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tv_total_balance"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/empty_wallets"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/color_on_surface_secondary"
        android:fontFamily="@font/outfit"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_total_balance"
        app:layout_constraintBottom_toTopOf="@id/btn_add_wallet_full"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_add_wallet_full"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="+ Add New Wallet"
        android:textSize="18sp"
        android:fontFamily="@font/outfit"
        android:textStyle="bold"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        app:backgroundTint="@color/color_on_surface"
        android:textColor="@color/color_surface"
        app:cornerRadius="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
